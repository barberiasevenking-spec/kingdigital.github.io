                        </ul>
                        <div class="mt-8 flex gap-4">
                            <a href="#" class="w-9 h-9 rounded-full bg-white/20 flex items-center justify-center hover:bg-white/40 transition-custom"><i class="fa fa-linkedin"></i></a>
                            <a href="#" class="w-9 h-9 rounded-full bg-white/20 flex items-center justify-center hover:bg-white/40 transition-custom"><i class="fa fa-twitter"></i></a>
                            <a href="#" class="w-9 h-9 rounded-full bg-white/20 flex items-center justify-center hover:bg-white/40 transition-custom"><i class="fa fa-instagram"></i></a>
